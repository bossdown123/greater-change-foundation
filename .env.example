# Optional cloud override. Default Compose database is private self-hosted Turso/libSQL.
# Set BOTH for Turso Cloud; never prefix with VITE_.
TURSO_DATABASE_URL=http://database:8080
TURSO_AUTH_TOKEN=
GCF_DOMAIN=greaterchangefoundation.org
GCF_IMAGE=ghcr.io/bossdown123/greater-change-foundation:main

# Run python3 deploy/local-secrets.py for local development values.
GCF_SESSION_SECRET=
GCF_ADMIN_EMAIL=
GCF_ADMIN_PASSWORD_HASH=
GARAGE_RPC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
