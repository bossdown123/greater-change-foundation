# Set BOTH for Turso Cloud; never prefix with VITE_.
TURSO_DATABASE_URL=http://database:8080
TURSO_AUTH_TOKEN=
GCF_DOMAIN=greaterchangefoundation.org
GCF_IMAGE=ghcr.io/bossdown123/greater-change-foundation:main
